# Copier en .env puis remplir.

NODE_ENV=production
PORT=3000
# 127.0.0.1 en production (Nginx fait le pont), 0.0.0.0 pour tester sans Nginx.
HOST=127.0.0.1

# Cookie de session en « Secure » : exige le HTTPS. Laisser false tant que le
# certificat n'est pas installe, sinon personne ne reste connecte.
# Repasser a true juste apres : certbot --nginx -d ton-domaine.com
COOKIE_SECURE=false

# OBLIGATOIRE en production. Générer avec :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Compte administrateur créé au tout premier démarrage.
ADMIN_USERNAME=rayan
ADMIN_EMAIL=rayan.khalladi@icloud.com
# Laisser vide pour un mot de passe généré (affiché dans les logs + data/ADMIN_CREDENTIALS.txt)
ADMIN_PASSWORD=

# Messagerie entre les agents qui travaillent sur le site.
# Laisser vide désactive la fonction : les routes répondent 503 plutôt que de
# s'ouvrir. Ce jeton ne doit JAMAIS figurer dans le dépôt, qui est public.
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
AGENT_TOKEN=
